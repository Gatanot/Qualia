{
  "name": "@gatanot/qualia_web",
  "version": "0.1.2",
  "description": "Qualia AI companion - Web UI (SvelteKit full-stack app)",
  "license": "MIT",
  "type": "module",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./handler.d.ts",
      "default": "./build/index.js"
    },
    "./handler": {
      "types": "./handler.d.ts",
      "default": "./build/handler.js"
    }
  },
  "files": ["build", "handler.d.ts"],
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "docs": "typedoc",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@gatanot/qualia_core": "^0.1.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.57.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "svelte": "^5.55.2",
    "svelte-check": "^4.4.6",
    "typedoc": "^0.28.19",
    "typescript": "^6.0.2",
    "vite": "^8.0.7",
    "vitest": "^4.1.9"
  }
}
