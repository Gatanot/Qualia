{
  "name": "qualia",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "npm run dev -w @gatanot/qualia_web",
    "build": "npm run build -w @gatanot/qualia_web",
    "check": "npm run check -w @gatanot/qualia_web",
    "check:watch": "npm run check:watch -w @gatanot/qualia_web",
    "check:core": "npm run check -w @gatanot/qualia_core",
    "docs": "npm run docs -w @gatanot/qualia_web",
    "test": "npm run test -w @gatanot/qualia_core",
    "sync": "node scripts/release.mjs sync",
    "sync:core": "node scripts/release.mjs sync:core",
    "sync:web": "node scripts/release.mjs sync:web",
    "version:check": "node scripts/release.mjs check",
    "version:bump": "node scripts/release.mjs bump",
    "release:build": "node scripts/release.mjs build",
    "release:pack": "node scripts/release.mjs pack",
    "release": "node scripts/release.mjs release"
  },
  "devDependencies": {
    "typescript": "^6.0.2",
    "vitest": "^4.1.9"
  }
